{
    "name": "matrix-platform/laravel-base",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "files": [
            "src/Helpers/base.php"
        ],
        "psr-4": {
            "MatrixPlatform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MatrixPlatform\\BaseServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.87",
        "larastan/larastan": "^3.7",
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "format": "php-cs-fixer fix",
        "lint": [
            "php-cs-fixer fix --dry-run --diff",
            "@php bin/style-check.php"
        ],
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
